# Sırsız örnek. Gerçek değerler gizli yöneticiden gelir; bu dosyaya gerçek sır yazılmaz.
NODE_ENV=development
API_PORT=4100
# Dinlenen arayüz: konteynerde 0.0.0.0 (varsayılan); yerel geliştirmede 127.0.0.1 ile ağdan erişim kapanır.
API_HOST=
# Migration/owner bağlantısı (RLS tablolarının sahibi). Uygulama bu rolle ÇALIŞMAZ.
DATABASE_OWNER_URL=postgres://sp_owner:local_owner_only@localhost:5544/satinalma
# Uygulama bağlantısı: NOSUPERUSER NOBYPASSRLS rol.
DATABASE_URL=postgres://sp_app:local_app_only@localhost:5544/satinalma
# Auth: "oidc" (üretim) veya "dev" (yalnız NODE_ENV=development; sentetik kullanıcılar)
AUTH_MODE=dev
# Herhangi bir OIDC uyumlu IdP (Keycloak, Entra ID, Okta, ADFS, Authentik...). Web, public client + PKCE kullanır.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
# İsteğe bağlı: sunucunun IdP'ye iç ağdan eriştiği keşif adresi; varsayılan <issuer>/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
# Kurumsal dizin farkları (ADFS, Entra ID). Ayrıntı: deploy/IDP.md
# OIDC_SCOPE=openid profile email
# OIDC_RESOURCE=                # ADFS: Web API tanımlayıcısı (ör. sp-api)
# OIDC_TOKEN_ISSUER=             # erişim token'ının iss'i farklıysa (ADFS: https://adfs.kurum/adfs/services/trust)
# OIDC_SUBJECT_CLAIM=sub         # Entra ID: oid
# OIDC_EMAIL_CLAIM=email         # ADFS: upn, Entra ID: preferred_username
# OIDC_TRUSTED_EMAIL_DOMAINS=    # email_verified göndermeyen kurum dizini: kurum.com.tr,kurum.local
# Dev token imza anahtarı; yerelde rastgele üretin: openssl rand -hex 32
DEV_AUTH_SECRET=
# Veri bölgesi politikası (AI/OCR sağlayıcı seçimi bunu aşamaz).
DATA_REGION=TR
# Dış sağlayıcılar: boşsa adaptörler BLOCKED/UNSUPPORTED döner, manuel akış çalışır.
SIGNATURE_DETECTOR_PROVIDER=
OCR_PROVIDER=
ESIGN_VALIDATOR_PROVIDER=
WEB_ORIGIN=http://localhost:5174
# Yerel ağdan erişim için ek kökenler (virgülle), ör. http://10.0.0.5:5174
WEB_EXTRA_ORIGINS=
# S3 uyumlu nesne deposu (Ceph RGW, SeaweedFS, MinIO, bulut S3...; yerelde docker compose objectstore)
OBJECT_STORE_ENDPOINT=http://localhost:9190
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=sp-documents-local
OBJECT_STORE_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=60
# Yerelde S3 emülatörü için yer tutucu. Gerçek ortamda sır yöneticisinden gelir (veya bulut IAM rolü).
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Entra dizin eşitlemesi (v2 Faz 2): graph | test | none (varsayılan none = bağlı değil).
# graph için üç ENTRA_* değişkeni de şart; sır yalnız ortamda tutulur, veritabanına/günlüğe yazılmaz.
DIRECTORY_PROVIDER=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# test sağlayıcısı için sentetik kullanıcı dosyası (gerçek Entra değildir), ör. apps/api/test/fixtures/directory-test.json
DIRECTORY_TEST_FIXTURE=
# Yapay zekâ sağlayıcısı (v2 Faz 4): none | test | anthropic (varsayılan none = bağlı değil; elle giriş akışı sürer).
# test = etiketli deterministik test sağlayıcısı ("Test sağlayıcısı — gerçek değil"), ücretsiz, ağ yok; üretimde başlangıçta reddedilir.
#   Yerel geliştirmede önerilen: AI_PROVIDER=test (seed, test-fixture katalog satırını ve demo kiracı politikasını ekler).
# anthropic = ücretli, kurum dışı: ANTHROPIC_API_KEY zorunlu; üretimde ayrıca AI_EXTERNAL_TRANSFER_APPROVED=true (KVKK/kurum onayı).
#   Katalogdaki anthropic satırı kapalı gelir; platform operasyonu tarifeyi doğrulayıp etkinleştirir.
AI_PROVIDER=none
# Tek model ayarı: sözleşme görevleri (AI06/AI14/AI15) yalnız bu model_id'li katalog satırına yönlenir.
AI_MODEL_ID=claude-sonnet-5-5
ANTHROPIC_API_KEY=
AI_EXTERNAL_TRANSFER_APPROVED=
# Oracle ERP entegrasyonu (v2 Faz 8): none | taklit | oracle-ebs (varsayılan none = bağlı değil; elle giriş akışları sürer).
# taklit = "Taklit Oracle (gerçek değil)": ağ yok, sentetik veri; sonuçları "taklit sağlayıcıyla denendi" olarak gösterilir; üretimde açılışta reddedilir.
# oracle-ebs = Oracle E-Business Suite REST; yol ve alan adları Yönetim > Entegrasyonlar kartında. Mevcut ERP_ADAPTER (fatura aktarımı) ayrıdır.
ERP_PROVIDER=none
# Uç nokta sırlarının (parola / istemci sırrı) zarf şifreleme anahtarı: base64, çözülünce en az 32 bayt (openssl rand -base64 32).
# Üretimde oracle-ebs için zorunlu; secret manager'dan gelir, bu dosyaya yazılmaz. Anahtar döndürülünce kartlarda sırlar yeniden girilir.
INTEGRATION_SECRET_KEY=
# İzinli ERP ana bilgisayarları (virgüllü ad ya da IPv4 CIDR), ör. ebs.kurum.local,10.20.0.0/16. Boşsa yalnız taklit çalışır.
# Yönlendirme izlenmez; üretimde yalnız https.
INTEGRATION_ALLOWED_HOSTS=
