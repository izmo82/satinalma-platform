# Ortam değişkenleri başlangıçta yerleştirilir (nginx resmi imajı envsubst; yalnız tanımlı değişkenler değişir).
# TLS önündeki yük dengeleyici/ingress'te sonlanır; bu sunucu iç ağda HTTP dinler.
server {
  listen 8080;
  root /usr/share/nginx/html;
  server_tokens off;
  client_max_body_size 26m;

  set $csp "default-src 'self'; img-src 'self' blob: data:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ${CSP_IDP_ORIGIN}; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self' ${CSP_IDP_ORIGIN}";
  add_header Content-Security-Policy $csp always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location = /healthz { access_log off; return 200 "ok\n"; }

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    # Belge içerikleri yetkiye bağlıdır; ara önbelleğe alınmaz.
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
  }
  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; add_header X-Content-Type-Options nosniff always; }
  location / { try_files $uri /index.html; }
}
