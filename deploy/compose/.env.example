# Kopyalayın: cp .env.example .env ; tüm CHANGE_ME değerlerini güçlü rastgele değerlerle değiştirin (openssl rand -hex 24).
# Bu dosya sır içerir; sürüm kontrolüne girmez. Kurumsal ortamda değerler sır yöneticisinden (Vault vb.) üretilir.
SP_PUBLIC_URL=http://localhost:8080
DATA_REGION=TR

OWNER_DB_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME

# S3 uyumlu depo. Varsayılan: yığındaki SeaweedFS. Harici depo için OBJECT_STORE_ENDPOINT/BUCKET değiştirin.
OBJECT_STORE_ACCESS_KEY=CHANGE_ME
OBJECT_STORE_SECRET_KEY=CHANGE_ME
#OBJECT_STORE_ENDPOINT=https://s3.kurum.local
#OBJECT_STORE_BUCKET=sp-documents

# Kimlik sağlayıcı (OIDC). Kurumun IdP'si: issuer, JWKS ve web için public client (PKCE) bilgileri.
# Yığındaki Keycloak (idp profili) için aşağıdaki değerler hazırdır.
OIDC_ISSUER=http://localhost:8180/realms/satinalma
OIDC_JWKS_URL=http://idp:8080/realms/satinalma/protocol/openid-connect/certs
OIDC_DISCOVERY_URL=http://idp:8080/realms/satinalma/.well-known/openid-configuration
OIDC_CLIENT_ID=sp-web
# Kurumsal dizin farkları (ADFS, Entra ID). Ayrıntı: deploy/IDP.md
# OIDC_SCOPE=openid profile email
# OIDC_RESOURCE=                # ADFS: Web API tanımlayıcısı (ör. sp-api)
# OIDC_TOKEN_ISSUER=             # erişim token'ının iss'i farklıysa (ADFS: https://adfs.kurum/adfs/services/trust)
# OIDC_SUBJECT_CLAIM=sub         # Entra ID: oid
# OIDC_EMAIL_CLAIM=email         # ADFS: upn, Entra ID: preferred_username
# OIDC_TRUSTED_EMAIL_DOMAINS=    # email_verified göndermeyen kurum dizini: kurum.com.tr,kurum.local
OIDC_AUDIENCE=sp-api
CSP_IDP_ORIGIN=http://localhost:8180

# Yalnız idp profili
IDP_PUBLIC_URL=http://localhost:8180
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# İmajlar (kayıt defterinizden): ör. registry.kurum.local/satinalma/api:0.1.0
#SP_API_IMAGE=satinalma/api:local
#SP_WEB_IMAGE=satinalma/web:local
