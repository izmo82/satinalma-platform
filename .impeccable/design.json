  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ekrandaki tek birincil eylem; koyu mürekkep zemin, satır içinde.",
      "html": "<button class=\"ds-btn-primary\">İşi aç</button>",
      "css": ".ds-btn-primary{font-family:'Source Sans 3 Variable',system-ui,-apple-system,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 16px;border-radius:6px;border:1px solid #1d2230;background:var(--ink,#1d2230);color:#f8f6f0;font-size:13px;font-weight:600;cursor:pointer;transition:background-color 150ms ease-out}.ds-btn-primary:hover{background:#2e3446}.ds-btn-primary:focus-visible{outline:2px solid var(--focus,#2f4f8f);outline-offset:2px;}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Varsayılan ikincil eylem; yüzey zemin, ince çerçeve.",
      "html": "<button class=\"ds-btn-outline\">Yenile</button>",
      "css": ".ds-btn-outline{font-family:'Source Sans 3 Variable',system-ui,-apple-system,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 16px;border-radius:6px;border:1px solid #ddd6c6;background:var(--surface,#fbfaf6);color:var(--ink,#1d2230);font-size:13px;font-weight:600;cursor:pointer;transition:background-color 150ms ease-out}.ds-btn-outline:hover{background:var(--selected,#e7e2d5)}.ds-btn-outline:focus-visible{outline:2px solid var(--focus,#2f4f8f);outline-offset:2px;}"
    },
    {
      "name": "Köken Etiketleri (Mor Istampa)",
      "kind": "custom",
      "refersTo": "tag-human",
      "description": "Sistemin imzası: insan kararı mor eğik kaşe, kural yeşil çerçeve, otomatik öneri kesik gri. Dekoratif kullanılmaz.",
      "html": "<div class=\"ds-legend\"><span>Kanıtın kökeni:</span><span class=\"ds-tag ds-tag-human\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 22h14\"/><path d=\"M19.27 13.73A2.5 2.5 0 0 0 17.5 13h-11A2.5 2.5 0 0 0 4 15.5V17a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-1.5c0-.66-.26-1.3-.73-1.77Z\"/><path d=\"M14 13V8.5C14 7 15 7 15 5a3 3 0 0 0-3-3c-1.66 0-3 1-3 3s1 2 1 3.5V13\"/></svg>İnsan kararı</span><span class=\"ds-tag ds-tag-ok\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Kural ile doğrulandı</span><span class=\"ds-tag ds-tag-ai\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z\"/></svg>Otomatik öneri</span></div>",
      "css": ".ds-legend{font-family:'Source Sans 3 Variable',system-ui,-apple-system,'Segoe UI',sans-serif;display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;font-size:13px;color:#4c5262}.ds-tag{font-family:'Source Sans 3 Variable',system-ui,-apple-system,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:6px;border-radius:4px;padding:1px 8px;font-size:13px;line-height:20px;font-weight:600;white-space:nowrap;}.ds-tag-human{border:1.5px solid #5b3fa0;color:#5b3fa0;background:#efeaf8;font-weight:700;transform:rotate(-1.5deg)}.ds-tag-ok{border:1.5px solid #2a6a59;color:#2a6a59;background:#e2efe9}.ds-tag-ai{border:1.5px dashed #5f6370;color:#5f6370;background:transparent}"
    },
    {
      "name": "Durum Etiketleri",
      "kind": "chip",
      "refersTo": "tag-warn",
      "description": "Uyarı, hata, bilgi: çerçevesiz yumuşak zemin, ikon ve metinle.",
      "html": "<div class=\"ds-row\"><span class=\"ds-tag ds-tag-warn\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m21.73 14-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/></svg>Yüksek</span><span class=\"ds-tag ds-tag-danger\">Gecikti · 12.10.2026</span><span class=\"ds-tag ds-tag-info\">İnceleme bekliyor</span></div>",
      "css": ".ds-row{display:flex;gap:8px;flex-wrap:wrap}.ds-tag{font-family:'Source Sans 3 Variable',system-ui,-apple-system,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:6px;border-radius:4px;padding:1px 8px;font-size:13px;line-height:20px;font-weight:600;white-space:nowrap;border:1px solid transparent}.ds-tag-warn{background:#f7ebcd;color:#855600}.ds-tag-danger{background:#f8e3de;color:#a8372a}.ds-tag-info{background:#e5e8ef;color:#33415e}"
    },
    {
      "name": "Filtre Çipi",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Basılı durumda koyu mürekkep; sayı tabular.",
      "html": "<div class=\"ds-row\"><button class=\"ds-chip\" aria-pressed=\"true\">Tümü <span class=\"ds-count\">24</span></button><button class=\"ds-chip\" aria-pressed=\"false\">Askıda <span class=\"ds-count\">3</span></button></div>",
      "css": ".ds-row{display:flex;gap:8px}.ds-chip{font-family:'Source Sans 3 Variable',system-ui,-apple-system,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:0 12px;border-radius:6px;border:1px solid #c2b9a5;background:#fbfaf6;color:#1d2230;font-size:13px;font-weight:600;cursor:pointer;transition:background-color 150ms}.ds-chip:hover{background:#ece8de}.ds-chip[aria-pressed=true]{background:#1d2230;border-color:#1d2230;color:#f8f6f0}.ds-chip .ds-count{font-variant-numeric:tabular-nums;color:#5c6270}.ds-chip[aria-pressed=true] .ds-count{color:#cfd2db}.ds-chip:focus-visible{outline:2px solid var(--focus,#2f4f8f);outline-offset:2px;}"
    },
    {
      "name": "Form Alanı",
      "kind": "input",
      "refersTo": "input",
      "description": "Alan beyazı zemin, güçlü çizgi, üstte etiket, altta ipucu; imleç mor.",
      "html": "<div class=\"ds-field\"><label for=\"ds-i\">Gerekçe</label><input id=\"ds-i\" class=\"ds-input\" placeholder=\"Kısa gerekçe\"><span class=\"ds-hint\">Denetim kaydına yazılır.</span></div>",
      "css": ".ds-field{font-family:'Source Sans 3 Variable',system-ui,-apple-system,'Segoe UI',sans-serif;display:grid;gap:4px;max-width:360px;color:#1d2230}.ds-field label{font-size:13px;font-weight:600}.ds-input{font:inherit;font-size:14px;min-height:36px;padding:6px 10px;border:1px solid #c2b9a5;border-radius:6px;background:#fff;color:#1d2230;caret-color:#5b3fa0}.ds-input:focus-visible{outline:2px solid var(--focus,#2f4f8f);outline-offset:2px;}.ds-input[aria-invalid=true]{border-color:#a8372a}.ds-hint{font-size:12px;color:#4c5262}"
    },
    {
      "name": "Menü Rayı",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Sol 256px açık kâğıt ray; etkin öğe mürekkep zemin, sağda bekleyen iş sayısı.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-nav is-active\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\"/><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"/></svg>İşlerim<span class=\"ds-n\">4</span></a><a class=\"ds-nav\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\"/><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"/></svg>Sözleşmeler<span class=\"ds-n\">2</span></a><a class=\"ds-nav\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\"/><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"/></svg>Faturalar<span class=\"ds-later\">Faz 4</span></a></nav>",
      "css": ".ds-rail{font-family:'Source Sans 3 Variable',system-ui,-apple-system,'Segoe UI',sans-serif;width:256px;box-sizing:border-box;padding:12px;background:#e9e5da;display:grid;gap:2px;border-right:1px solid #ddd6c6}.ds-nav{display:flex;align-items:center;gap:12px;min-height:36px;padding:0 10px;border-radius:6px;font-size:14px;font-weight:600;color:#4c5262;text-decoration:none;transition:background-color 150ms}.ds-nav:hover{background:#ece8de;color:#1d2230}.ds-nav.is-active{background:#1d2230;color:#f8f6f0}.ds-nav:focus-visible{outline:2px solid var(--focus,#2f4f8f);outline-offset:2px;}.ds-n{margin-left:auto;font-size:13px;font-variant-numeric:tabular-nums}.ds-later{margin-left:auto;font-size:12px;font-weight:400;color:#4c5262}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Kart yerine çizgiyle ayrılmış panel; gölgesiz, başlık şeridi alt çizgili.",
      "html": "<section class=\"ds-panel\"><header class=\"ds-panel-head\">Durum</header><dl class=\"ds-facts\"><dt>Sonuç</dt><dd>Eksik</dd><dt>Otomatik tarama</dt><dd class=\"ds-muted\">Yapılmadı</dd></dl></section>",
      "css": ".ds-panel{font-family:'Source Sans 3 Variable',system-ui,-apple-system,'Segoe UI',sans-serif;max-width:420px;background:#fbfaf6;border:1px solid #ddd6c6;border-radius:6px;color:#1d2230;font-size:14px}.ds-panel-head{padding:12px 16px;border-bottom:1px solid #ddd6c6;font-weight:650}.ds-facts{display:grid;grid-template-columns:max-content 1fr;gap:8px 16px;margin:0;padding:16px}.ds-facts dt{color:#4c5262}.ds-facts dd{margin:0}.ds-muted{color:#4c5262}"
